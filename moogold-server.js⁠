require('dotenv').config();

const express = require('express');
const cors = require('cors');
const helmet = require('helmet');
const crypto = require('crypto');

const app = express();

app.use(helmet());
app.use(cors({
  origin: process.env.FRONTEND_ORIGIN || false
}));
app.use(express.json({ limit: '1mb' }));

app.get('/', (req, res) => {
  res.json({
    status: 'ONLINE',
    service: 'MooGold API Server'
  });
});

async function callMooGoldApi(endpointPath, payloadObj) {
  const partnerId = process.env.MOOGOLD_PARTNER_ID;
  const secretKey = process.env.MOOGOLD_SECRET_KEY;

  if (!partnerId || !secretKey) {
    throw new Error('Server configuration is missing MooGold credentials.');
  }

  const timestamp = Math.floor(Date.now() / 1000);
  const payloadJson = JSON.stringify(payloadObj);
  const stringToSign = payloadJson + timestamp + endpointPath;

  const authSignature = crypto
    .createHmac('sha256', secretKey)
    .update(stringToSign)
    .digest('hex');

  const basicAuth = Buffer
    .from(`${partnerId}:${secretKey}`)
    .toString('base64');

  const response = await fetch(
    `https://moogold.com/wp-json/v1/api/${endpointPath}`,
    {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        timestamp: String(timestamp),
        auth: authSignature,
        Authorization: `Basic ${basicAuth}`
      },
      body: payloadJson,
      signal: AbortSignal.timeout(15000)
    }
  );

  const responseText = await response.text();
  let result;

  try {
    result = responseText ? JSON.parse(responseText) : {};
  } catch {
    result = { message: responseText };
  }

  if (!response.ok) {
    const error = new Error(`MooGold API returned HTTP ${response.status}`);
    error.status = response.status;
    error.details = result;
    throw error;
  }

  return result;
}

function sendError(res, err) {
  console.error('MooGold request failed:', err.message);

  res.status(err.status || 500).json({
    error: err.status
      ? 'MooGold API request failed.'
      : 'Server error.'
  });
}

// ឆែកសមតុល្យ
app.post('/api/moogold/balance', async (req, res) => {
  try {
    const payload = { path: 'user/balance' };
    const data = await callMooGoldApi('user/balance', payload);
    res.json(data);
  } catch (err) {
    sendError(res, err);
  }
});

// បង្កើតការបញ្ជាទិញ
app.post('/api/moogold/create-order', async (req, res) => {
  try {
    const { variationId, playerId, serverId } = req.body || {};

    if (!variationId || !playerId) {
      return res.status(400).json({
        error: 'ត្រូវបញ្ចូល Variation ID និង Player ID។'
      });
    }

    const orderData = {
      category: 1,
      'product-id': String(variationId),
      quantity: 1,
      'User ID': String(playerId)
    };

    if (serverId) {
      orderData.Server = String(serverId);
    }

    const payload = {
      path: 'order/create_order',
      data: orderData
    };

    const result = await callMooGoldApi(
      'order/create_order',
      payload
    );

    res.json({
      success: true,
      moogoldResponse: result
    });
  } catch (err) {
    sendError(res, err);
  }
});

const PORT = Number(process.env.PORT) || 3000;

app.listen(PORT, () => {
  console.log(`MooGold API server running on port ${PORT}`);
});
