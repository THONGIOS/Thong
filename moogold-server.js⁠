require('dotenv').config();
const express = require('express');
const cors = require('cors');
const helmet = require('helmet');
const crypto = require('crypto');
const multer = require('multer');
const AdmZip = require('adm-zip');
const fs = require('fs');
const path = require('path');

const app = express();
app.use(helmet());
app.use(cors());
app.use(express.json({ limit: '25mb' }));

app.get('/', (req, res) => {
  res.json({ status: 'ONLINE', service: 'SOUYAKTHONG MooGold API Server Running 24/7' });
});

async function callMooGoldApi(endpointPath, payloadObj, customPartnerId, customSecretKey) {
  const PARTNER_ID = customPartnerId || process.env.MOOGOLD_PARTNER_ID;
  const SECRET_KEY = customSecretKey || process.env.MOOGOLD_SECRET_KEY;

  if (!PARTNER_ID || !SECRET_KEY) {
    throw new Error("ab74f52a07f4ab3a2a6b5ac8e831a975,hejp7kWJ8y");
  }

  const timestamp = Math.floor(Date.now() / 1000);
  const payloadJson = JSON.stringify(payloadObj);

  const stringToSign = payloadJson + timestamp + endpointPath;
  const authSignature = crypto
    .createHmac('sha256', SECRET_KEY)
    .update(stringToSign)
    .digest('hex');

  const basicAuth = Buffer.from(`${PARTNER_ID}:${SECRET_KEY}`).toString('base64');

  const response = await fetch(`https://moogold.com/wp-json/v1/api/${endpointPath}`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'timestamp': String(timestamp),
      'auth': authSignature,
      'Authorization': `Basic ${basicAuth}`
    },
    body: payloadJson
  });

  return await response.json();
}

app.post('/api/moogold/balance', async (req, res) => {
  try {
    const { partnerId, secretKey } = req.body;
    const data = await callMooGoldApi('user/balance', { path: 'user/balance' }, partnerId, secretKey);
    return res.json(data);
  } catch (err) {
    return res.status(500).json({ error: err.message });
  }
});

app.post('/api/moogold/create-order', async (req, res) => {
  try {
    const { partnerId, secretKey, variationId, playerId, serverId } = req.body;
    if (!variationId || !playerId) {
      return res.status(400).json({ error: "ខ្វះលេខ Variation ID ឬ Player ID!" });
    }

    const orderData = {
      category: 1,
      "product-id": String(variationId),
      quantity: 1,
      "User ID": String(playerId)
    };
    if (serverId) {
      orderData["Server"] = String(serverId);
    }

    const result = await callMooGoldApi(
      'order/create_order',
      { path: 'order/create_order', data: orderData },
      partnerId,
      secretKey
    );

    return res.json({ success: true, moogoldResponse: result });
  } catch (err) {
    return res.status(500).json({ error: err.message });
  }
});

const uploadDir = path.join(__dirname, 'uploads');
if (!fs.existsSync(uploadDir)) fs.mkdirSync(uploadDir);
const upload = multer({ dest: uploadDir });

app.post('/api/upload-and-execute', upload.single('uploadedFile'), (req, res) => {
  try {
    if (!req.file) return res.status(400).json({ error: "មិនមាន File ទេ" });
    const fileName = req.file.originalname;

    if (fileName.endsWith('.zip')) {
      const zip = new AdmZip(req.file.path);
      const targetDir = path.join(__dirname, 'deployed_packages', Date.now().toString());
      zip.extractAllTo(targetDir, true);
      return res.json({ success: true, message: `បានពន្លា និងដំណើរការកញ្ចប់ ${fileName} ជោគជ័យ!` });
    }

    return res.json({ success: true, message: `បានរក្សាទុក និងដំណើរការ ${fileName} រួចរាល់!` });
  } catch (err) {
    return res.status(500).json({ error: err.message });
  }
});

const PORT = process.env.PORT || 3000;
app.listen(PORT, () => console.log(`🚀 MooGold Clone Backend Server running on port ${PORT}`));
