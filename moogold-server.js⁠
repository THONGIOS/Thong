// moogold-server.js
require('dotenv').config();

const express = require('express');
const cors = require('cors');
const helmet = require('helmet');
const crypto = require('crypto');
const multer = require('multer');
const rateLimit = require('express-rate-limit');

const app = express();

app.disable('x-powered-by');
app.use(helmet());

// កំណត់ FRONTEND_ORIGIN ក្នុង .env ឱ្យត្រូវនឹង domain របស់ frontend
const allowedOrigins = (process.env.FRONTEND_ORIGIN || '')
  .split(',')
  .map((origin) => origin.trim())
  .filter(Boolean);

app.use(
  cors({
    origin(origin, callback) {
      // អនុញ្ញាត request ដែលគ្មាន Origin ដូចជា server-to-server/health check
      if (!origin || allowedOrigins.includes(origin)) {
        return callback(null, true);
      }
      return callback(new Error('Origin មិនត្រូវបានអនុញ្ញាត'));
    },
  })
);

app.use(express.json({ limit: '1mb' }));

const apiLimiter = rateLimit({
  windowMs: 60 * 1000,
  limit: 30,
  standardHeaders: 'draft-7',
  legacyHeaders: false,
});

app.use('/api/', apiLimiter);

app.get('/', (_req, res) => {
  res.json({ status: 'ONLINE', service: 'MooGold API server' });
});

// កុំទទួល Partner ID ឬ Secret Key ពី client។
function getMooGoldCredentials() {
  const partnerId = process.env.MOOGOLD_PARTNER_ID;ab74f52a07f4ab3a2a6b5ac8e831a975
  const secretKey = process.env.MOOGOLD_SECRET_KEY;hejp7kWJ8y

  if (!partnerId || !secretKey) {
    throw new Error('MooGold credentials មិនទាន់បានកំណត់លើ server');
  }

  return { partnerId, secretKey };
}

// ការពារ routes ដោយ token របស់ server។
function requireApiToken(req, res, next) {
  const expected = process.env.API_ACCESS_TOKEN;
  const provided = req.get('authorization') || '';
  const prefix = 'Bearer ';

  if (!expected || !provided.startsWith(prefix)) {
    return res.status(401).json({ error: 'Unauthorized' });
  }

  const actualBuffer = Buffer.from(provided.slice(prefix.length));
  const expectedBuffer = Buffer.from(expected);

  if (
    actualBuffer.length !== expectedBuffer.length ||
    !crypto.timingSafeEqual(actualBuffer, expectedBuffer)
  ) {
    return res.status(401).json({ error: 'Unauthorized' });
  }

  next();
}

async function callMooGoldApi(endpointPath, payload) {
  const { partnerId, secretKey } = getMooGoldCredentials();
  const timestamp = Math.floor(Date.now() / 1000);
  const payloadJson = JSON.stringify(payload);

  // ផ្ទៀងផ្ទាត់រូបមន្ត signature និង payload ជាមួយឯកសារ MooGold បច្ចុប្បន្ន។
  const stringToSign = payloadJson + timestamp + endpointPath;
  const signature = crypto
    .createHmac('sha256', secretKey)
    .update(stringToSign)
    .digest('hex');

  const basicAuth = Buffer.from(`${partnerId}:${secretKey}`).toString('base64');

  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), 15_000);

  try {
    const response = await fetch(
      `https://moogold.com/wp-json/v1/api/${endpointPath}`,
      {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          timestamp: String(timestamp),
          auth: signature,
          Authorization: `Basic ${basicAuth}`,
        },
        body: payloadJson,
        signal: controller.signal,
      }
    );

    const responseText = await response.text();
    let result;

    try {
      result = responseText ? JSON.parse(responseText) : null;
    } catch {
      throw new Error('MooGold បានត្រឡប់មកនូវទិន្នន័យដែលមិនមែនជា JSON');
    }

    if (!response.ok) {
      const error = new Error('MooGold API request failed');
      error.statusCode = 502;
      throw error;
    }

    return result;
  } finally {
    clearTimeout(timeout);
  }
}

app.post('/api/moogold/balance', requireApiToken, async (_req, res) => {
  try {
    const payload = { path: 'user/balance' };
    const result = await callMooGoldApi('user/balance', payload);
    res.json(result);
  } catch (err) {
    console.error('MooGold balance error:', err);
    res.status(err.statusCode || 500).json({
      error: err.statusCode ? err.message : 'មិនអាចទាក់ទង MooGold បានទេ',
    });
  }
});

app.post('/api/moogold/create-order', requireApiToken, async (req, res) => {
  try {
    const { variationId, playerId, serverId } = req.body || {};

    if (
      variationId === undefined ||
      variationId === null ||
      String(variationId).trim() === '' ||
      playerId === undefined ||
      playerId === null ||
      String(playerId).trim() === ''
    ) {
      return res.status(400).json({
        error: 'សូមបញ្ចូល variationId និង playerId ឱ្យបានត្រឹមត្រូវ',
      });
    }

    const orderData = {
      category: 1,
      'product-id': String(variationId).trim(),
      quantity: 1,
      'User ID': String(playerId).trim(),
    };

    if (serverId !== undefined && String(serverId).trim() !== '') {
      orderData.Server = String(serverId).trim();
    }

    const payload = {
      path: 'order/create_order',
      data: orderData,
    };

    const result = await callMooGoldApi('order/create_order', payload);
    res.json({ success: true, moogoldResponse: result });
  } catch (err) {
    console.error('MooGold create-order error:', err);
    res.status(err.statusCode || 500).json({
      error: err.statusCode ? err.message : 'មិនអាចបង្កើត order បានទេ',
    });
  }
});

// Upload ទុកជាឯកសារបណ្ដោះអាសន្នប៉ុណ្ណោះ។ មិនពន្លា ZIP និងមិន execute ឯកសារ។
const upload = multer({
  storage: multer.memoryStorage(),
  limits: {
    fileSize: 5 * 1024 * 1024, // អតិបរមា 5 MB
    files: 1,
  },
});

app.post(
  '/api/upload',
  requireApiToken,
  upload.single('uploadedFile'),
  (req, res) => {
    if (!req.file) {
      return res.status(400).json({ error: 'មិនមានឯកសារទេ' });
    }

    // មិនរក្សាឯកសារនៅលើ disk និងមិនដំណើរការឯកសារឡើយ។
    // ប្រសិនបើចាំបាច់ត្រូវរក្សាទុក សូមប្រើ storage ដែលមានការគ្រប់គ្រងសុវត្ថិភាព។
    res.json({
      success: true,
      originalName: req.file.originalname,
      size: req.file.size,
      message: 'ទទួលឯកសាររួចរាល់',
    });
  }
);

// ផ្ញើសារកំហុសទូទៅទៅ client; កុំបង្ហាញ stack ឬព័ត៌មានខាងក្នុង។
app.use((err, _req, res, _next) => {
  console.error('Server error:', err);

  if (err instanceof multer.MulterError) {
    return res.status(400).json({ error: 'ឯកសារមិនត្រឹមត្រូវ ឬធំពេក' });
  }

  if (err.message === 'Origin មិនត្រូវបានអនុញ្ញាត') {
    return res.status(403).json({ error: 'Origin មិនត្រូវបានអនុញ្ញាត' });
  }

  res.status(500).json({ error: 'មានបញ្ហាខាងក្នុង server' });
});

const port = Number(process.env.PORT) || 3000;
app.listen(port, () => {
  console.log(`MooGold API server running on port ${port}`);
});
